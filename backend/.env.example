# Dockerfile Generator Backend Configuration
APP_NAME="Dockerfile Generator"
VERSION="0.1.0"
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# GitHub
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_CLONE_DEPTH=1
GITHUB_CLONE_TIMEOUT=120

# File processing
MAX_ZIP_SIZE_MB=100
MAX_GITHUB_REPO_SIZE_MB=500
TEMP_DIR=/tmp/dockerfile-gen

# Ollama (AI optimization)
OLLAMA_ENABLED=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=codellama:7b
OLLAMA_TIMEOUT=60